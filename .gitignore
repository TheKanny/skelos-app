# Git ignore for SKELOS

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# Streamlit/Local temp files
temp_video.mp4
.streamlit/

# OS files
.DS_Store
Thumbs.db

# Secrets and Config (IMPORTANT)
